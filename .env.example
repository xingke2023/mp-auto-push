# 元宝AI配置
# 智能体ID，必需配置
YUANBAO_ASSISTANT_ID=your_assistant_id_here
# Token，必需配置
YUANBAO_TOKEN=your_yuanbao_token_here
# 用户ID，可选配置，不设置会自动生成
YUANBAO_USER_ID=your_user_id

# Google AI 图片生成配置 (可选)
# Google AI API Key，用于调用 Gemini 图片生成服务
# 获取地址: https://aistudio.google.com/apikey
# 优先级：本地 .env 文件 > 系统环境变量
GOOGLE_API_KEY=your_google_api_key_here
# 图片生成模型，默认使用 gemini-2.5-flash-image
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

# 腾讯云 OCR 配置 (可选)
# 腾讯云 Secret ID 和 Secret Key，用于图片文字识别
# 获取地址: https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRET_ID=your_tencent_secret_id_here
TENCENTCLOUD_SECRET_KEY=your_tencent_secret_key_here

# Paddle OCR 配置 (可选)
# Paddle OCR API URL 和 Token，用于 PDF 和图片的 OCR 识别
# API URL 和 Token 由服务提供方提供
PADDLE_OCR_API_URL=https://u8yeibc471q3e274.aistudio-app.com/ocr
PADDLE_OCR_TOKEN=your_paddle_ocr_token_here

# Paddle Layout 配置 (可选，更先进的布局解析)
# Paddle Layout API URL 和 Token，用于 PDF 和图片的布局解析
# 比 Paddle OCR 更先进，可以将文档转换为 Markdown 格式并保留文档结构
# API URL 和 Token 由服务提供方提供
PADDLE_LAYOUT_API_URL=https://u9x0gfmaod92r0q2.aistudio-app.com/layout-parsing
PADDLE_LAYOUT_TOKEN=your_paddle_layout_token_here

# DeepSeek AI 配置 (可选)
# DeepSeek API Key，用于智能稿件改写和内容生成
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek API 地址，默认使用官方地址
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# DeepSeek 模型，默认使用 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek 请求超时时间（毫秒），默认 300000（5分钟）
DEEPSEEK_TIMEOUT=300000

# OpenAI API 配置 (可选)
# OpenAI API Key，用于调用 GPT 系列模型
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI API 地址，默认使用官方地址（支持自定义中转地址）
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OpenAI 模型，默认使用 gpt-5-nano (支持 GPT-5, GPT-4o, GPT-4, GPT-3.5 等)
OPENAI_MODEL=gpt-5-nano
# OpenAI 请求超时时间（毫秒），默认 300000（5分钟）
OPENAI_TIMEOUT=300000
# OpenAI 最大 Token 数，默认 4096
OPENAI_MAX_TOKENS=4096

# 微信公众号配置 (必需)
# 在微信公众平台获取 https://mp.weixin.qq.com/
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# 发布配置 (可选)
# 是否自动发布草稿，true=立即发布，false=仅创建草稿 (默认: false)
AUTO_PUBLISH=false
# 发布后是否检查发布状态，true=检查状态，false=不检查 (默认: true)
CHECK_PUBLISH_STATUS=true

# API服务配置 (可选)
# API服务端口号 (默认: 5003)
API_PORT=5003
# API访问密钥，用于接口认证。不设置则跳过认证（不建议生产环境）
# 建议使用强密码，如: openssl rand -hex 32
API_KEY=your_secure_api_key_here
# 默认封面图URL（当客户端未提供封面图时使用）
# 留空表示必须提供封面图，否则报错
# 建议使用自己服务器上的图片，确保可公网访问
# DEFAULT_COVER_IMAGE=https://your-domain.com/default-cover.jpg

# 数据库配置 (可选)
# 用于存储上传的图片 URL 记录
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=template1

# 注意事项:
# 1. 复制此文件为 .env 并填入真实配置
# 2. 如果不配置微信公众号信息，文章将保存到本地 output 目录
# 3. 请确保微信公众号已认证并开通相关接口权限
# 4. 自动发布功能需要微信公众号具备发布权限
# 5. 发布的文章可能需要经过微信审核，请注意内容合规
# 6. API_KEY用于保护远程接口，请务必设置强密码
# 7. API服务启动命令: npm run api